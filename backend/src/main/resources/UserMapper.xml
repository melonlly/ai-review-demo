<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.demo.mapper.UserMapper">

    <select id="findByUsername" resultType="com.demo.domain.User">
        SELECT * FROM users WHERE username = '${username}'
    </select>

    <select id="listAllUsers" resultType="com.demo.domain.User">
        SELECT * FROM users ORDER BY create_time DESC
    </select>

    <!-- 新增：按用户名关键字模糊查询 -->
    <select id="findByName" resultType="com.demo.domain.User">
        SELECT * FROM users WHERE name LIKE '%${keyword}%'
    </select>

    <select id="findByIdSafe" resultType="com.demo.domain.User">
        SELECT * FROM users WHERE id = #{id} AND tenant_id = #{tenantId}
    </select>

</mapper>